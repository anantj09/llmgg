# "mock" runs fully offline. Switch to "openai_compatible" for a real LLM.
PROVIDER=mock

# Any OpenAI-compatible API. Groq has a free tier: https://console.groq.com
UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
UPSTREAM_API_KEY=
DEFAULT_MODEL=openai/gpt-oss-20b

# Clients must send "Authorization: Bearer <key>". Empty = no auth (local only!)
GATEWAY_API_KEYS=

POLICY_PATH=policies/default.yaml
DB_PATH=data/gateway.db
LOG_LEVEL=INFO
